{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FLOWCONTROL Constrained Strategy",
  "type": "object",
  "required": [
    "name",
    "description",
    "rules"
  ],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 3,
      "maxLength": 80
    },
    "description": {
      "type": "string",
      "minLength": 10,
      "maxLength": 1000
    },
    "rules": {
      "type": "object",
      "required": [
        "reserveBps",
        "rebalanceThresholdBps",
        "maxTradeUsd",
        "maxAssets",
        "momentumOnly",
        "cooldownSeconds",
        "maxTradesPerDay"
      ],
      "properties": {
        "reserveBps": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 9000
        },
        "rebalanceThresholdBps": {
          "type": "integer",
          "minimum": 100,
          "maximum": 3000
        },
        "maxTradeUsd": {
          "type": "number",
          "minimum": 5,
          "maximum": 100000
        },
        "maxAssets": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12
        },
        "momentumOnly": {
          "type": "boolean"
        },
        "cooldownSeconds": {
          "type": "integer",
          "minimum": 60,
          "maximum": 86400
        },
        "maxTradesPerDay": {
          "type": "integer",
          "minimum": 1,
          "maximum": 48
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
